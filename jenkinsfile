pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        //git branch: 'main', url: 'https://github.com/harsha0320/newwwwwww.git'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'mvn clean package'
        sh 'ls -lrt'
      }
    }
    stage('Upload to S3') {
      steps {
        sh 'aws s3 cp target/demo-app-1.0.0.jar s3://jenkinsbucket0011/'
      }
    }
  }
}
